#!/bin/sh
#
# pre-push 钩子：推送前扫描即将上传的内容，拦截敏感信息。
#
# 为什么需要它：密钥一旦推上 GitHub，即使立刻删除，它也已经进了历史，
# 而且会被爬虫抓走（GitHub 自带的 secret scanning 也会拦，但那是最后一道）。
# 在本地拦住成本最低。
#
# 安装：git config core.hooksPath .githooks
# 绕过（确认安全时）：git push --no-verify

set -u

fail=0
report() {
  echo ""
  echo "  ✗ 拦截：$1"
  echo "     $2"
  fail=1
}

echo "  [pre-push] 扫描待推送内容..."

# ---------------------------------------------------------------------------
# 1. 收集要检查的文件清单
#    必须同时包含两部分，缺一不可：
#      (a) 已提交但还没推送的（本地领先远端的提交）
#      (b) 已 add 进暂存区、还没提交的——这是最容易泄密的时刻
# ---------------------------------------------------------------------------
upstream=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || true)
if [ -n "$upstream" ]; then
  commits=$(git rev-list "$upstream"..HEAD 2>/dev/null || true)
else
  commits=$(git rev-list HEAD 2>/dev/null || true)
fi

if [ -n "$commits" ]; then
  commit_files=$(git diff-tree --no-commit-id --name-only -r $commits 2>/dev/null | sort -u)
else
  commit_files=""
fi
staged_files=$(git diff --cached --name-only 2>/dev/null || true)

files=$(printf '%s\n%s\n' "$commit_files" "$staged_files" | sort -u | sed '/^$/d')

for f in $files; do
  case "$f" in
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.woff|*.woff2|*.xlsx|*.zip)
      continue ;;
  esac

  if [ ! -f "$f" ]; then
    continue
  fi

  if grep -qE 'gh[pousr]_[A-Za-z0-9]{20,}' "$f" 2>/dev/null; then
    report "$f" "检测到 GitHub token（ghp_/gho_/ghu_/ghs_/ghr_ ...）"
  fi
  if grep -qE 'BEGIN [A-Z ]*PRIVATE KEY' "$f" 2>/dev/null; then
    report "$f" "检测到私钥内容"
  fi
  if grep -qE '(AKIA|ASIA)[0-9A-Z]{16}' "$f" 2>/dev/null; then
    report "$f" "检测到 AWS Access Key"
  fi
  if grep -qiE '(password|passwd|app[_-]?secret|api[_-]?key|access[_-]?token)[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{8,}' "$f" 2>/dev/null; then
    report "$f" "检测到形如 password=/api_key= 的赋值"
  fi
  if grep -qE 'Cookie:[[:space:]]*[A-Za-z0-9_]+=' "$f" 2>/dev/null; then
    report "$f" "检测到 Cookie 头内容"
  fi
done

# ---------------------------------------------------------------------------
# 2. 文件名黑名单：登录态与凭据绝不能进版本库
#    同时检查已跟踪文件和暂存区
# ---------------------------------------------------------------------------
tracked=$(printf '%s\n%s\n' "$(git ls-files)" "$staged_files" | sort -u | sed '/^$/d')
for f in $tracked; do
  case "$f" in
    */profile/*|profile/*)
      report "$f" "浏览器用户目录（含登录态 Cookie）不得提交" ;;
    *Cookies*|*"Login Data"*)
      report "$f" "浏览器凭据文件不得提交" ;;
    *git-cred*|*credential*|*.token|*.pem|*.key|id_rsa*|id_ed25519*)
      report "$f" "疑似凭据文件不得提交" ;;
    *.env|*.env.*)
      report "$f" "环境变量文件不得提交" ;;
  esac
done

# ---------------------------------------------------------------------------
# 3. 提交者邮箱提醒（只警告，不阻止）
# ---------------------------------------------------------------------------
emails=$(printf '%s\n' "$(git log --format='%ae%n%ce' ${commits:-HEAD} 2>/dev/null | sort -u)")
for e in $emails; do
  case "$e" in
    *noreply*)
      : ;;
    *@163.com|*@qq.com|*@gmail.com|*@outlook.com|*@hotmail.com|*@126.com|*@sina.com)
      echo ""
      echo "  ! 提醒：提交者邮箱是真实邮箱（$e），公开仓库会显示出来"
      echo "    不想暴露的话，改成 GitHub 的 noreply 地址并重建提交："
      echo "      git config user.email \"<你的数字ID>+SMAXHERO@users.noreply.github.com\""
      ;;
  esac
done

echo ""
if [ "$fail" = "1" ]; then
  echo "  ✗ 已阻止推送。请移除上述内容后重试。"
  echo "    确认无误要强行推送：git push --no-verify"
  exit 1
fi

echo "  [pre-push] 未发现问题（检查了 $(echo "$files" | wc -l) 个文件）。"
exit 0
